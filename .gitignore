# Standard Unity .gitignore rules
# Ref: https://github.com/github/gitignore/blob/main/Unity.gitignore

[aA]ssets/AssetStoreTools*

# External Code Formatting Packages
[aA]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code / Rider project files
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated build & temporary directories
[lL]ibrary/
[tT]emp/
[oO]bj/
[bB]uild/
[bB]uilds/
[lL]ogs/
[uU]ser[sS]ettings/
[mM]emoryCaptures/
[rR]ecordings/

# Asset cache
[dD]erivedDataCache/

# Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Only README.md is tracked as Markdown.
*.[mM][dD]
!/README.md

# Local project documentation and older working notes.
/.local_docs/

# Copias locales de documentos de referencia
/Plan_Desarrollo_Unity_Musiyo_Betsknate*.docx
/Propuesta_Curatorial_Salas_Musiyo_Betsknate*.docx
/Requerimientos_Musiyo_Betsknate*.docx

# Herramientas locales, resultados y archivos personales de trabajo
/.codex/
/.agents/
/TestResults/
/artifacts/
*.log
*.tmp
*.bak
~$*
*.slnx
.env
.env.*
!.env.example
Desktop.ini

# Capturas y cachés generadas por Unity
/[Aa]ssets/[Ss]treamingAssets/aa/
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*.meta
